{
  "name": "@coparent/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist cdk.out",
    "bootstrap": "cdk bootstrap",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy CoparentBackend-dev",
    "deploy:staging": "cdk deploy CoparentBackend-staging",
    "deploy:production": "cdk deploy CoparentBackend-production"
  },
  "dependencies": {
    "@aws-sdk/client-chime-sdk-media-pipelines": "^3.1168.0",
    "@aws-sdk/client-chime-sdk-meetings": "^3.1168.0",
    "@aws-sdk/client-comprehend": "^3.800.0",
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.4.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.3",
    "aws-cdk": "^2.1000.0",
    "esbuild": "^0.25.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
